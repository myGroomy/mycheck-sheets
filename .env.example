# .env.example – konfigurasi lingkungan mycheck
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env yang sudah terisi.

# ---------------------------------------------------------------------------
# Google Service Account (wajib)
# Sheet Registry + seluruh spreadsheet cabang diakses sebagai service account.
# Akun ini harus punya akses Editor ke spreadsheet Registry dan tiap cabang.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Registry (wajib)
# Spreadsheet pusat berisi sheet: Daftar_Cabang, Settings_Global, Users,
# Share_Tokens, Template_Referensi.
# ---------------------------------------------------------------------------
REGISTRY_SPREADSHEET_ID=

# Folder Drive untuk unggah foto checklist.
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Keamanan
# Kunci HMAC-SHA256 untuk menandatangani cookie sesi (minimal 32 karakter).
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Opsional
# ---------------------------------------------------------------------------
# URL dan kunci Google Apps Script Web App (lihat apps-script/README).
# Jalankan setupKeys() di Apps Script untuk mendapatkan kedua kunci.
# GAS dipakai untuk upload foto (kuota SA = 0) dan admin Drive.
MYCHECK_GAS_URL=
MYCHECK_GAS_UPLOAD_KEY=
MYCHECK_GAS_ADMIN_KEY=

# Upstash Redis untuk draft dan buffer event shift (server-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MYCHECK_SHIFT_BUFFER_MODE=redis

PORT=3000
